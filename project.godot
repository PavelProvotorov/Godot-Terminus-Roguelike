[application]

config/name="Terminus (v2.0 Dev)"
run/main_scene="res://scenes/Game.tscn"
config/icon="res://icon.png"

[autoload]

Events="*res://scripts/singletons/events.gd"
Resources="*res://scripts/singletons/resources.gd"
Global="*res://scripts/singletons/global.gd"
Config="*res://scripts/singletons/config.gd"

[display]

window/size/width=160
window/size/height=120
window/size/resizable=false
window/size/test_width=1920
window/size/test_height=1440
window/dpi/allow_hidpi=true
window/stretch/mode="2d"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PoolStringArray(  )

[importer_defaults]

texture={
"flags/filter": false
}

